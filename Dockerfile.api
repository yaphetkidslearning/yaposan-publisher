FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package*.json ./
RUN npm install --ignore-scripts

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache ffmpeg \
 && addgroup -S yaposan \
 && adduser -S yaposan -G yaposan
COPY --from=dependencies /app/node_modules ./node_modules
COPY server ./server
COPY scripts/export-worker.ts ./scripts/export-worker.ts
COPY package.json tsconfig.json ./
USER yaposan
EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD wget -qO- http://127.0.0.1:${PORT:-4100}/health || exit 1
CMD ["node", "--import", "tsx", "server/index.ts"]
