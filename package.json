{
  "name": "yaposan",
  "main": "expo-router/entry",
  "version": "119.10.9",
  "dependencies": {
    "@expo/ui": "~57.0.4",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "blob-stream": "0.1.3",
    "bmp-js": "0.1.0",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-document-picker": "~14.0.4",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-print": "~57.0.0",
    "expo-router": "~57.0.4",
    "expo-sharing": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "0.17.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "svg-to-pdfkit": "0.1.8",
    "tesseract.js": "^6.0.1",
    "utif": "3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bmp-js": "0.1.2",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "~19.2.2",
    "@types/svg-to-pdfkit": "0.1.4",
    "@types/xlsx": "^0.0.35",
    "cross-env": "^7.0.3",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "web": "node scripts/start-web-with-api.mjs",
    "dev:web": "node scripts/start-web-with-api.mjs",
    "web:frontend": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "lint": "expo lint",
    "typecheck": "npm run typecheck:full",
    "typecheck:full": "tsc --noEmit -p tsconfig.ci.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "build:web": "expo export --platform web",
    "check": "npm run typecheck && npm run lint",
    "test": "npm run test:current",
    "test:current": "node scripts/run-current-tests.mjs",
    "test:maintained": "npm run test:current",
    "test:all": "npm run test:current",
    "test:release": "npm run test:current",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "package:source": "node scripts/create-source-release.mjs",
    "security:gitleaks": "gitleaks git . --config .gitleaks.toml",
    "licenses:check": "node scripts/check-dependency-licenses.mjs",
    "open-source:preflight": "npm run typecheck:full && npm run lint -- --quiet && npm run test:release && npm run security:secrets:tree && npm run licenses:check",
    "public:preflight": "npm run open-source:preflight && npm run build:web",
    "verify:production": "node scripts/verify-production.mjs",
    "preflight:production": "node scripts/production-preflight-1174.mjs",
    "certify:production:ci": "npm run open-source:preflight",
    "certify:production": "npm run certify:production:ci",
    "certify:production:live": "npm run certify:production:ci && npm run verify:production",
    "worker:export": "node --experimental-strip-types scripts/export-worker.ts",
    "worker:product-photo": "node --env-file-if-exists=.env --import tsx server/productPhotoBatchWorker.ts",
    "photo-engine": "docker compose up --build background-removal",
    "background:start:windows": "powershell -ExecutionPolicy Bypass -File scripts/start-background-removal.ps1",
    "background:test:windows": "powershell -ExecutionPolicy Bypass -File scripts/test-background-removal.ps1",
    "owner:setup": "node scripts/setup-owner-access.mjs",
    "user:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-local-user.ts",
    "user:status": "node --env-file-if-exists=.env --import tsx scripts/user-status.ts",
    "user:password": "node --env-file-if-exists=.env --import tsx scripts/reset-local-user-password.ts",
    "desktop:web": "npx expo export --platform web --output-dir dist",
    "desktop:build": "npm run desktop:web && node scripts/desktop-package.mjs current && npm run desktop:manifest",
    "desktop:build:win": "npm run desktop:web && node scripts/desktop-package.mjs win && npm run desktop:manifest",
    "desktop:build:mac": "npm run desktop:web && node scripts/desktop-package.mjs mac && npm run desktop:manifest",
    "desktop:build:linux": "npm run desktop:web && node scripts/desktop-package.mjs linux && npm run desktop:manifest",
    "desktop:portable": "npm run desktop:web && node scripts/desktop-portable-package.mjs && npm run desktop:manifest",
    "desktop:manifest": "node scripts/desktop-installer-manifest.mjs",
    "desktop:dev": "cross-env YAPOSAN_DESKTOP_DEV_URL=http://localhost:8081 electron desktop/main.cjs",
    "desktop:pack": "npm run build:web && electron-builder --dir",
    "desktop:dist": "npm run build:web && electron-builder",
    "desktop:publish:win": "npm run desktop:web && npx electron-builder --config electron-builder.yml --win --publish always",
    "desktop:publish:mac": "npm run desktop:web && npx electron-builder --config electron-builder.yml --mac --publish always",
    "desktop:publish:linux": "npm run desktop:web && npx electron-builder --config electron-builder.yml --linux --publish always",
    "deploy:validate": "node deploy/scripts/validate-deployment.mjs .env.production",
    "deploy:config": "docker compose -f docker-compose.deploy.yml config",
    "deploy:build": "docker compose -f docker-compose.deploy.yml build",
    "deploy:up": "docker compose -f docker-compose.deploy.yml up -d",
    "deploy:down": "docker compose -f docker-compose.deploy.yml down",
    "deploy:render:validate": "node deploy/scripts/validate-render-blueprint.mjs render.yaml",
    "deploy:smoke": "node deploy/scripts/hosted-smoke-test.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "security:secrets:tree": "node scripts/scan-source-secrets.mjs",
    "test:community": "node tests/current-release.test.mjs"
  },
  "private": true,
  "description": "Open-source AI-powered page and creative platform for personal AI, publishing, community, content, and bring-your-own-provider workflows.",
  "build": {
    "appId": "com.yaposan.publisher",
    "productName": "Yaposan Publisher",
    "asar": true,
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release/desktop"
    },
    "publish": {
      "provider": "github",
      "owner": "yaphetkidslearning",
      "repo": "yaposan-publisher",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Yaposan-Publisher-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "artifactName": "Yaposan-Publisher-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraMetadata": {
      "main": "desktop/main.cjs"
    }
  },
  "license": "MIT",
  "homepage": "https://yaposan.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/yaphetkidslearning/yaposan-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/yaphetkidslearning/yaposan-publisher/issues"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@10",
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "tesseract.js@6.0.1": true,
    "unrs-resolver@1.12.2": true
  }
}
