{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["tests", "src", "node_modules", "dist", ".expo"]
}
