{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "scripts/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "tests",
    "node_modules",
    "dist",
    ".expo",
    "release/history"
  ]
}
