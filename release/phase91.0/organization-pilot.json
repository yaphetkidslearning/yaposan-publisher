{
  "phase": "91.0",
  "organizationPreset": "Marketplace Product Photos",
  "maxPilotUsers": 50,
  "batchSelectLimit": 500,
  "defaultBackground": "white",
  "defaultPaddingPercent": 10,
  "defaultSquareCanvas": true,
  "defaultQualityMode": "auto",
  "reviewQueueEnabled": true,
  "manualKeepRemoveTouchup": true,
  "stagedRolloutUsers": [2, 5, 10, 50],
  "measure": ["processed", "auto-pass", "review", "failed", "manual-touchup", "average-processing-ms", "quality-mode", "model-used", "paid-api-cost-usd"],
  "goLiveRule": "Do not move to 50 users until representative organization photos meet quality targets and pilot users accept the workflow."
}
