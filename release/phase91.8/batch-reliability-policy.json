{
  "phase": "91.8",
  "title": "Durable Batch Reliability and Pure White Production",
  "batch": {
    "maxImages": 500,
    "serverSideJobs": true,
    "uniqueJobId": true,
    "resumeAfterBrowserClose": true,
    "states": ["awaiting-upload", "queued", "processing", "pass", "review", "failed"],
    "retryOnlyReviewOrFailed": true,
    "serverSideZip": true,
    "recentHistory": true,
    "progressAndEta": true,
    "perUserActiveBatchLimit": 3,
    "perOrganizationActiveBatchLimit": 20,
    "idempotency": true,
    "safeFilenameCollisionHandling": true,
    "retentionHoursDefault": 72,
    "staleWorkerRecovery": true,
    "perFileUploadInsteadOfOneHugeBatchPayload": true,
    "workerQueue": true
  },
  "pureWhite": {
    "exactRgb": [255,255,255],
    "shadowOff": true,
    "exactBackgroundCompliance": 1.0,
    "nonWhiteBackgroundPixelsMaximum": 0,
    "postExportAudit": true,
    "certifiedFormats": ["png", "lossless-webp"],
    "jpegMode": "marketplace-white-not-exact-white-certified",
    "whiteOnWhiteForcesDetailPath": true,
    "failureAction": "review"
  },
  "operations": {
    "metrics": ["queueDepth", "p50ProcessingMs", "p95ProcessingMs", "pass", "review", "failed"],
    "auditEventOnCompletion": true,
    "paidApiSpendUsd": 0
  }
}
