  "paidApi": {
    "enabledByDefault": false,
    "monthlyBudgetUsd": 0,
    "autoOverage": false
  },
  "claim": "Batch means one user job may contain up to 500 photos. The service intentionally uses bounded parallel workers rather than launching 500 simultaneous model inferences."
