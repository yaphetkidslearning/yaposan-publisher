NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://yaposan:yaposan@localhost:5432/yaposan
SESSION_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
STORAGE_DRIVER=local
STORAGE_BUCKET=yaposan-assets
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
PUBLIC_ASSET_BASE_URL=http://localhost:4100/api/v1/assets/raw
EXPO_PUBLIC_API_URL=http://localhost:4100

# Phase 71 billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Phase 71 AI gateway
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_DEFAULT_MODEL=gpt-4.1-mini

# Phase 75 security and observability
PUBLIC_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
REDIS_URL=redis://localhost:6379

# RC1 production integrations
STORAGE_DRIVER=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=
EMAIL_FROM=Yaposan <no-reply@example.com>
ADMIN_EMAILS=
COLLABORATION_DRIVER=memory
EXPORT_WORKER_ENABLED=false

# RC2 secure worker authentication
EXPORT_WORKER_TOKEN=replace-with-a-long-random-secret
R2_SIGNING_REGION=auto

# RC4 export execution and publication
EXPORT_WORKER_POLL_MS=1000
LOCAL_STORAGE_ROOT=.yaposan-storage

# Phase 90.6 prepaid AI credit packs (Stripe one-time prices)
STRIPE_PRICE_AI_CREDITS_SMALL=
STRIPE_PRICE_AI_CREDITS_STANDARD=
STRIPE_PRICE_AI_CREDITS_MORE=

# Phase 90.7 AI cost controls and secure BYO-provider vault
AI_COMMUNITY_MONTHLY_BUDGET_USD=50
AI_DEFAULT_INPUT_USD_PER_MILLION_TOKENS=1
AI_DEFAULT_OUTPUT_USD_PER_MILLION_TOKENS=4
# Exactly 32 bytes, base64-encoded (or 64 hex characters). Generate separately for production.
AI_CREDENTIAL_ENCRYPTION_KEY=

# Phase 90.8 AI financial integrity and provider network hardening
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_RESPONSE_BYTES=1048576
AI_COMMUNITY_USER_REQUESTS_PER_HOUR=20
AI_COMMUNITY_ORG_REQUESTS_PER_HOUR=100
# JSON mapping supports provider:model, model, or provider keys.
# Example: {"openai:gpt-4.1-mini":{"inputUsdPerMillion":0.40,"outputUsdPerMillion":1.60}}
AI_MODEL_PRICING_JSON={}
# During rotation, put the previous 32-byte base64/64-hex keys here, comma-separated.
AI_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# Legacy subscription APIs are disabled by default. Set true only for controlled migration work.
YAPOSAN_ENABLE_LEGACY_SUBSCRIPTIONS=false

# Phase 90.9 provider credential key version and AI request safety
AI_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
AI_CREDENTIAL_ENCRYPTION_KEYS_PREVIOUS_JSON={}
AI_MAX_PROMPT_BYTES=65536
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_CONCURRENT_REQUESTS_PER_USER=3
AI_MAX_CONCURRENT_REQUESTS_PER_ORG=10
AI_COMMUNITY_USER_REQUESTS_PER_DAY=50
AI_COMMUNITY_ORG_REQUESTS_PER_DAY=250
AI_COMMUNITY_ORG_REQUESTS_PER_MONTH=2000
AI_PROVIDER_MAX_RETRIES=2
AI_PROVIDER_RETRY_BASE_MS=250
