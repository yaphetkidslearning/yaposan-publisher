# Yaposan environment template
# Copy this file to .env for local development and replace placeholders as needed.
# Never commit real credentials, secrets, production URLs, or private keys.

# Public client configuration
EXPO_PUBLIC_API_URL=http://localhost:4100
# Browser-facing application URL. PUBLIC_WEB_URL is the canonical URL used in
# verification/password-reset links. PUBLIC_APP_URL is retained for deployment compatibility.
PUBLIC_WEB_URL=http://localhost:8081
PUBLIC_APP_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:4100

# Account email verification and password recovery (Resend)
# Production: set RESEND_API_KEY, a verified sender, and a real PUBLIC_WEB_URL.
RESEND_API_KEY=
EMAIL_FROM=Yaposan <no-reply@yaposan.com>
# Local development without Resend: keep this true for production-like testing, then run `npm run user:verify -- user@example.com` after registration.
# Set RESEND_API_KEY + a verified EMAIL_FROM to test real delivery.
REQUIRE_EMAIL_VERIFICATION=true

# Server/database
DATABASE_URL=
PORT=4100
NODE_ENV=development

# separate Yaposan Admin domain. These credentials are never customer/Space credentials.
ADMIN_SESSION_SECRET=
# Use a real deliverable mailbox in production so Admin recovery email works (for example: admin@yaposan.com).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_HOURS=8

# AI provider configuration (optional unless hosted/provider AI is enabled)
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
AI_COMMUNITY_MONTHLY_BUDGET_USD=0

# Payments (optional unless Stripe billing is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Product photo engine
YAPOSAN_BG_STANDARD_MODEL=birefnet-general-lite
YAPOSAN_BG_DETAIL_MODEL=birefnet-general
YAPOSAN_BG_REVIEW_SCORE=0.93
YAPOSAN_BG_RETRY_SCORE=0.90
YAPOSAN_BG_AGREEMENT_IOU=0.91
YAPOSAN_BG_AUTO_DETAIL_DIFFICULTY=0.28
YAPOSAN_BG_MAX_BYTES=50000000
YAPOSAN_BG_MAX_PIXELS=50000000
YAPOSAN_BG_MAX_CONCURRENCY=8
YAPOSAN_BG_RETRY_ATTEMPTS=3
YAPOSAN_BG_CACHE_SIZE=256
YAPOSAN_BG_CATALOG_OCCUPANCY=0.78
YAPOSAN_BG_WEBP_QUALITY=92
YAPOSAN_BG_MATTING_MODEL=birefnet-general
YAPOSAN_BG_PEOPLE_MODEL=birefnet-portrait
YAPOSAN_BG_PRODUCT_MODEL=birefnet-general
YAPOSAN_BG_FINE_DETAIL_MODEL=birefnet-general
YAPOSAN_BG_MODEL_VERSION=yaposan-94-birefnet-routing
YAPOSAN_BG_PHASE2_DATA_DIR=/tmp/yaposan-bg-phase2
YAPOSAN_BG_CORRECTION_RETENTION_DAYS=30
YAPOSAN_BG_CORRECTION_MAX_MASK_BYTES=25000000
YAPOSAN_BG_CORRECTION_CLEANUP_INTERVAL_SECONDS=3600
YAPOSAN_BG_DEPLOYMENT_ENV=development
# In production set a strong secret and require service auth. Never expose correction-data routes directly to clients.
YAPOSAN_BG_PHASE2_SERVICE_TOKEN=
YAPOSAN_BG_PHASE2_REQUIRE_SERVICE_AUTH=false
# Set STORAGE_ENCRYPTED=true only when the configured background-removal data directory is backed by encrypted storage.
YAPOSAN_BG_PHASE2_STORAGE_ENCRYPTED=false
YAPOSAN_BG_PHASE2_REQUIRE_ENCRYPTED_STORAGE=false
YAPOSAN_BG_CORRECTION_RATE_LIMIT_PER_MINUTE=60
YAPOSAN_BG_CORRECTION_MAX_STORED_EXAMPLES=100000
YAPOSAN_BG_INFERENCE_QUEUE_TIMEOUT_SECONDS=2
# Optional infrastructure-cost telemetry; 0 disables the estimate.
YAPOSAN_BG_INFRA_COST_USD_PER_HOUR=0
# Optional approved candidate lane for shadow/canary release. Keep traffic at 0 until registry/benchmark gates pass.
YAPOSAN_BG_CANDIDATE_MODEL=
YAPOSAN_BG_CANDIDATE_MODEL_VERSION=
YAPOSAN_BG_CANDIDATE_TRAFFIC_PERCENT=0
YAPOSAN_BG_CANDIDATE_SHADOW_MODE=true
YAPOSAN_BG_CANDIDATE_PRODUCTION_APPROVED=false
# 91.7 pure-white batch defaults
YAPOSAN_BG_STRICT_WHITE_DEFAULT=true
YAPOSAN_BG_BATCH_MAX_IMAGES=500

# Observability / production integrations (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=
# durable Product Photo batch worker
PRODUCT_PHOTO_WORKER_TOKEN=
PRODUCT_PHOTO_WORKER_ID=product-photo-worker-1
PRODUCT_PHOTO_JOB_LEASE_SECONDS=120
PRODUCT_PHOTO_WORKER_POLL_MS=1000
PRODUCT_PHOTO_BATCH_MAX_IMAGES=500
PRODUCT_PHOTO_BATCH_MAX_TOTAL_BYTES=5000000000
PRODUCT_PHOTO_MAX_ACTIVE_BATCHES_PER_USER=3
PRODUCT_PHOTO_MAX_ACTIVE_BATCHES_PER_ORG=20
PRODUCT_PHOTO_BATCH_ITEM_CONCURRENCY=4
PRODUCT_PHOTO_BATCH_RETENTION_HOURS=72

# dedicated media generation providers.
# Each URL should accept POST JSON {prompt, model?, ...options} and return either a direct asset URL
# (url/uri/output_url/outputUrl) or a provider job id (id/job_id/jobId).
AI_IMAGE_PROVIDER_URL=
AI_IMAGE_PROVIDER_API_KEY=
AI_IMAGE_PROVIDER_MODEL=
AI_IMAGE_PROVIDER_NAME=image-provider
AI_IMAGE_PROVIDER_STATUS_URL=
AI_IMAGE_PROVIDER_CANCEL_URL=
AI_VIDEO_PROVIDER_URL=
AI_VIDEO_PROVIDER_API_KEY=
AI_VIDEO_PROVIDER_MODEL=
AI_VIDEO_PROVIDER_NAME=video-provider
AI_VIDEO_PROVIDER_STATUS_URL=
AI_VIDEO_PROVIDER_CANCEL_URL=
AI_AUDIO_PROVIDER_URL=
AI_AUDIO_PROVIDER_API_KEY=
AI_AUDIO_PROVIDER_MODEL=
AI_AUDIO_PROVIDER_NAME=audio-provider
AI_AUDIO_PROVIDER_STATUS_URL=
AI_AUDIO_PROVIDER_CANCEL_URL=
# STATUS/CANCEL URL templates may include {id}, e.g. https://provider.example/jobs/{id}

# Photo Studio background engine.
# Start with: docker compose up --build background-removal
BACKGROUND_REMOVAL_URL=http://127.0.0.1:8090
BACKGROUND_REMOVAL_TIMEOUT_MS=300000
BACKGROUND_REMOVAL_MAX_IMAGE_BYTES=50000000

# identity & security
# Production recommendation: oidc with Keycloak, ZITADEL, or compatible provider.
IDENTITY_PROVIDER=local
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
REQUIRE_EXTERNAL_IDENTITY=false
# ClamAV/scan-gateway integration endpoint for quarantined elevated uploads.
MALWARE_SCANNER_URL=
# stdout emits structured yaposan.security.v1 events for Wazuh/SIEM collection.
SECURITY_EVENT_SINK=stdout

# creator advertising: 1000=10%, 2000=20%, 3000=30%
YAPOSAN_AD_PLATFORM_FEE_BPS=2000

PUBLIC_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

# local runtime note: keep every variable on its own line.
# npm run web validates PUBLIC_ORIGINS against PUBLIC_WEB_URL/PUBLIC_APP_URL and refuses stale API reuse after relevant .env changes.

# persistent local development database used when DATABASE_URL is blank.
YAPOSAN_LOCAL_DB_PATH=.yaposan/local-database.json
YAPOSAN_LOCAL_DB_LOCK_TIMEOUT_MS=30000
YAPOSAN_LOCAL_DB_STALE_LOCK_MS=300000
YAPOSAN_LOCAL_DB_WARN_BYTES=26214400
YAPOSAN_LOCAL_DEV_TOKEN_PATH=.yaposan/local-dev-token
# Set true only for disposable tests that intentionally want RAM-only data.
YAPOSAN_IN_MEMORY_ONLY=false
