# Public deployment endpoints
EXPO_PUBLIC_API_URL=https://api.yaposan.com
WEB_PORT=8080
PUBLIC_ORIGINS=https://app.yaposan.com

# Core services
POSTGRES_DB=yaposan
POSTGRES_USER=yaposan
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://yaposan:GENERATE_A_LONG_RANDOM_PASSWORD@postgres:5432/yaposan
REDIS_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
REDIS_URL=redis://:GENERATE_A_LONG_RANDOM_PASSWORD@redis:6379

# Security secrets - generate independently, minimum 32 characters
SESSION_SECRET=GENERATE_64_RANDOM_CHARACTERS
EXPORT_WORKER_TOKEN=GENERATE_64_RANDOM_CHARACTERS
BACKUP_SIGNING_SECRET=GENERATE_64_RANDOM_CHARACTERS
LICENSE_SIGNING_SECRET=GENERATE_64_RANDOM_CHARACTERS
METRICS_TOKEN=GENERATE_64_RANDOM_CHARACTERS

# Storage - Cloudflare R2
STORAGE_DRIVER=r2
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=yaposan-production
STORAGE_REGION=auto
R2_SIGNING_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PUBLIC_ASSET_BASE_URL=https://cdn.yaposan.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# AI and email
OPENAI_API_KEY=
AI_DEFAULT_MODEL=gpt-4.1-mini
RESEND_API_KEY=
EMAIL_FROM=Yaposan <no-reply@yaposan.com>
ADMIN_EMAILS=

# Production operation
NODE_ENV=production
PORT=4100
COLLABORATION_DRIVER=redis
EXPORT_WORKER_ENABLED=true
EXPORT_WORKER_ID=export-worker-1
EXPORT_JOB_LEASE_SECONDS=60
EXPORT_WORKER_POLL_MS=1000
FFMPEG_PATH=/usr/bin/ffmpeg
RENDERER_TIMEOUT_MS=120000
TRUST_PROXY=true
READINESS_STORAGE_PROBE=true
